# App & Server Settings
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://fundcompass.vercel.app

# Paths
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
SCHEMES_DATA_PATH=./data/processed/schemes.json
